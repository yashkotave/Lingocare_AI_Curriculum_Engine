# Copy this file to .env.local and fill in your key.
#
# Local development:  .env.local is read by the dev server (see vite.config.js)
# Deployed:           add the same variable in your Vercel project settings
#                     (Settings -> Environment Variables) before deploying.
#
# This key is only ever read inside /api/parse-curriculum.js on the server.
# It is never sent to the browser. Do not prefix it with VITE_ — anything
# prefixed VITE_ is inlined into the client bundle and would leak the key.
GEMINI_API_KEY=your_key_here

# Optional: override the model used for parsing.
# GEMINI_MODEL=gemini-2.5-flash
